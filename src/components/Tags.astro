---
interface Props {
  tags: string[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap justify-center text mt-4">
  <span class="cursor-default">tags:</span>
  {
    tags.map((tag) => (
      <a
        href={`/tag/${tag}`}
        class="px-1 cursor-pointer select-none" 
      >
        {tag}
      </a>
    ))
  }
</div>
